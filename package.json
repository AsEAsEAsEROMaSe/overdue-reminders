{
  "name": "overdue-reminders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check:headers": "node scripts/check-headers.mjs",
    "check:mutations": "node scripts/mutation-check.mjs",
    "coverage": "node node_modules/vitest/vitest.mjs run --coverage --coverage.include=src --coverage.reporter=text",
    "demo": "node scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
